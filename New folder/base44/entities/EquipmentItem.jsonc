{
  "name": "EquipmentItem",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "personal",
        "group"
      ],
      "default": "group"
    },
    "responsible_id": {
      "type": "string"
    },
    "responsible_name": {
      "type": "string"
    },
    "is_checked": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "name"
  ]
}